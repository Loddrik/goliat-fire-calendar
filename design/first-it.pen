              "fill": "$fg",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "• Cita así: GOLIAT, NASA FIRMS (MODIS/VIIRS), comuna de Coihueco, datos hasta el 13-11-2026.",
