                    },
                    {
                      "type": "text",
                      "id": "ASHOA",
                      "name": "Viñeta 1",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "• Copia la fila de la temporada que necesitas; los meses con más celdas-día son los que concentran la actividad.",
                      "lineHeight": 1.4,
                      "fontFamily": "$font-body",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "ZOagH",
                      "name": "Viñeta 2",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "• Cita así: GOLIAT, NASA FIRMS (MODIS/VIIRS), comuna de Penco, datos hasta el 13-11-2026.",
                      "lineHeight": 1.4,
                      "fontFamily": "$font-body",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "B0yaZr",
                      "name": "Viñeta 3",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "• El total por temporada aparecerá aquí cuando esté publicado; mientras tanto, suma los meses de la fila.",
                      "lineHeight": 1.4,
                      "fontFamily": "$font-body",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
